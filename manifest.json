  "external_skills": [
    {
      "repo": "https://github.com/jbellsolutions/ghl-super-hub",
      "path": "skills/",
      "install": "bash install.sh --link"
    }
  ],
  "required_approval_actions": [
    "send or publish any external message",
    "launch, change or grow a campaign, or load a list",
    "create, publish or change a GHL workflow, form, pipeline, custom field or calendar",
    "accept or reject a partner",
    "change program facts, terms or approved claims",
    "export contact data",
    "create or turn on a routine",
    "spend money or start a subscription"
  ],
  "permanently_denied_actions": [
    "state, negotiate, approve or pay a referral fee or commission",
    "quote rates, terms, approval odds, closing times or loan amounts, or promise partner income",
    "underwrite, price, issue a term sheet or move a loan past Quick App Sent",
    "ask for or store Social Security numbers, bank details, credit reports, passwords or ID numbers",
    "delete anything in GHL",
    "move money or change billing, payment, phone number or A2P settings",
    "use the owner's login, pull session cookies or get around a permission",
    "claim to be a person when asked",
    "change its own permissions or these rules"
  ]
}
